      "Bash(herdr workspace rename *)",
      "Bash(herdr tab list *)",
      "Bash(herdr tab get *)",
      "Bash(herdr tab create *)",
      "Bash(herdr tab focus *)",
      "Bash(herdr tab rename *)",
      "Bash(herdr session list *)"
