      "Bash(herdr * --machine *)",
      "Bash(herdr * --machine=*)",
      "Bash(herdr --remote *)",
      "Bash(herdr --remote=*)",
      "Bash(herdr * --remote *)",
      "Bash(herdr * --remote=*)",
      "Bash(herdr *machine add*)",
