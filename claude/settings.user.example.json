      "Bash(herdr pane)",
      "Bash(herdr workspace)",
      "Bash(herdr tab)",
      "Bash(herdr session)",
      "Bash(herdr worktree)",
      "Bash(herdr notification)",
      "Bash(herdr integration)",
      "Bash(herdr machine)",
      "Bash(herdr api)",
      "Bash(herdr status *)",
      "Bash(herdr agent list *)",
      "Bash(herdr agent get *)",
      "Bash(herdr agent read *)",
      "Bash(herdr agent wait *)",
      "Bash(herdr agent explain *)",
      "Bash(herdr agent focus *)",
      "Bash(herdr agent rename *)",
      "Bash(herdr pane list *)",
      "Bash(herdr pane current *)",
      "Bash(herdr pane get *)",
      "Bash(herdr pane layout *)",
